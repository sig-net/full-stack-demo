  "views": {
    "public.midnight_ethereum_erc20_vault_activity_v1": {
      "columns": {
        "name": {
          "name": "name",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "type": {
          "name": "type",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "state": {
          "name": "state",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "deposit_account": {
          "name": "deposit_account",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "erc20_address": {
          "name": "erc20_address",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "amount": {
          "name": "amount",
          "type": "numeric(39, 0)",
          "primaryKey": false,
          "notNull": true
        },
        "outcome": {
          "name": "outcome",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "error": {
          "name": "error",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "deposit_state": {
          "name": "deposit_state",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "vault_request_state": {
          "name": "vault_request_state",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "wallet_transaction": {
          "name": "wallet_transaction",
          "type": "jsonb",
          "primaryKey": false,
          "notNull": false
        },
        "start_transaction": {
          "name": "start_transaction",
          "type": "jsonb",
          "primaryKey": false,
          "notNull": false
        },
        "foreign_chain_transaction": {
          "name": "foreign_chain_transaction",
          "type": "jsonb",
          "primaryKey": false,
          "notNull": false
        },
        "complete_transaction": {
          "name": "complete_transaction",
          "type": "jsonb",
          "primaryKey": false,
          "notNull": false
        },
        "create_time": {
          "name": "create_time",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true
        },
        "update_time": {
          "name": "update_time",
          "type": "timestamp with time zone",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n    SELECT\n      d.name AS name,\n      'Deposit' AS type,\n      CASE d.state WHEN 'Completed' THEN 'Complete' WHEN 'Failed' THEN 'Failed' ELSE 'Pending' END AS state,\n      d.deposit_account AS deposit_account,\n      d.erc20_address AS erc20_address,\n      d.amount AS amount,\n      d.outcome AS outcome,\n      d.error AS error,\n      d.state AS deposit_state,\n      r.state AS vault_request_state,\n      CASE WHEN c.state = 'AwaitingWallet' AND c.signer = 'caller' THEN jsonb_build_object('name', c.name, 'circuit', c.circuit, 'expireTime', c.expire_time) WHEN s.state = 'AwaitingWallet' AND s.signer = 'caller' THEN jsonb_build_object('name', s.name, 'circuit', s.circuit, 'expireTime', s.expire_time) ELSE NULL END AS wallet_transaction,\n      CASE WHEN s.name IS NULL THEN NULL ELSE jsonb_build_object('hash', s.tx_id, 'state', CASE s.state WHEN 'Succeeded' THEN 'Succeeded' WHEN 'Failed' THEN 'Failed' ELSE 'Pending' END, 'lifecycleState', s.state) END AS start_transaction,\n      CASE WHEN e.name IS NULL THEN NULL ELSE jsonb_build_object('hash', e.tx_hash, 'state', CASE e.state WHEN 'Succeeded' THEN 'Succeeded' WHEN 'Failed' THEN 'Failed' ELSE 'Pending' END, 'lifecycleState', e.state) END AS foreign_chain_transaction,\n      CASE WHEN c.name IS NULL THEN NULL ELSE jsonb_build_object('hash', c.tx_id, 'state', CASE c.state WHEN 'Succeeded' THEN 'Succeeded' WHEN 'Failed' THEN 'Failed' ELSE 'Pending' END, 'lifecycleState', c.state) END AS complete_transaction,\n      d.create_time AS create_time,\n      GREATEST(d.update_time, s.update_time, r.update_time, e.update_time, c.update_time) AS update_time\n    FROM \"midnight_ethereum_erc20_vault_deposits_v1\" d\n    LEFT JOIN LATERAL (SELECT * FROM \"midnight_transactions_v1\" x WHERE x.parent = d.name AND x.circuit = 'startDeposit' ORDER BY x.create_time DESC, x.name LIMIT 1) s ON TRUE\n    LEFT JOIN LATERAL (SELECT * FROM \"midnight_ethereum_erc20_vault_requests_v1\" x WHERE x.parent = d.name ORDER BY x.create_time DESC, x.name LIMIT 1) r ON TRUE\n    LEFT JOIN LATERAL (SELECT * FROM \"ethereum_transactions_v1\" x WHERE x.parent = r.name ORDER BY x.create_time DESC, x.name LIMIT 1) e ON TRUE\n    LEFT JOIN LATERAL (SELECT * FROM \"midnight_transactions_v1\" x WHERE x.parent = d.name AND x.circuit = 'completeDeposit' ORDER BY x.create_time DESC, x.name LIMIT 1) c ON TRUE\n  ",
      "name": "midnight_ethereum_erc20_vault_activity_v1",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
