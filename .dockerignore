# Build context for the production image. Mirrors .gitignore, then drops what the image builds itself.
.git
node_modules
.next
out
build
coverage
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.quality-tools
.local-vault
.playwright-mcp
.vercel
*scratch*
*.tsbuildinfo
next-env.d.ts

# Environment files carry the local deployment and server credentials. The image takes public
# values as build arguments and server values from its runtime environment.
.env*
!.env.example

# The zk-assets stage regenerates the serving tree inside the image.
public/zk
public/zk.stage-*
public/zk.previous
public/zk.prepare.lock

# Not part of the application build.
.agents
.github
docs
tests
Dockerfile
.dockerignore
