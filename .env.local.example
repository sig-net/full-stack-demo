# The local stack: copy to .env.local, then fill in the five values the midnight-examples setup
# generated (see Getting started in README.md). Next.js reads .env files from the project root.

MIDNIGHT_NETWORK_ID=undeployed
# The local stack deploys its own signet singleton and vault, so all three are required.
# midnight-examples writes them to its .env as MIDNIGHT_SIGNET_CONTRACT_ADDRESS,
# MPC_SECP256K1_PUBKEY and MIDNIGHT_VAULT_CONTRACT_ADDRESS.
MIDNIGHT_SIGNET_CONTRACT_ADDRESS=<32-byte hex>
MIDNIGHT_SIGNET_MPC_ROOT_PUBLIC_KEY=<secp256k1 public key, SEC1 hex>
MIDNIGHT_ETHEREUM_ERC20_VAULT_CONTRACT_ADDRESS=<32-byte hex>

# The local EVM node is an anvil fork of Sepolia, so the chain id stays Sepolia's and the RPC
# is the fork.
EVM_CHAIN_ID=11155111
EVM_RPC_URL=http://127.0.0.1:8545

# Server-only values never reach the browser. Both match the services `yarn stack:up` starts.
DB_CONNECTION_STRING=postgres://demo:demo@localhost:5432/demo
KAFKA_BROKERS=localhost:9092

# The backend's own Midnight wallet, which proves and pays for the permissionless vault
# transactions. On the local stack it is one of the wallets the midnight-examples setup funded:
# its BEARER_SEED.
MIDNIGHT_RELAYER_SEED=<32-byte seed in hex>

# Tests only. The integration tests play the user with this funded wallet: the midnight-examples
# setup's USER_SEED.
MIDNIGHT_USER_SEED=<32-byte seed in hex>

# debug shows every step of a deposit on the local stack.
LOG_LEVEL=debug

# Everything else takes the undeployed network's defaults: the node at 127.0.0.1:9944, the
# indexer at 127.0.0.1:8088, the proof server at 127.0.0.1:6300 and the fakenet's MPC output
# cache at 127.0.0.1:3040. README.md's Configuration section lists every variable.
