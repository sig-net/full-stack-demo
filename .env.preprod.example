# Preprod: copy to .env.local and fill in the Blockfrost project token and the relayer seed.
# Next.js reads .env files from the project root.

# Preprod publishes the signet signer, the signet responder, the MPC root key and the vault through
# the SDK packages.
MIDNIGHT_NETWORK_ID=preprod
# Blockfrost serves preprod's node and indexer and answers only requests carrying a project token:
# create a "Midnight Preprod" project at https://blockfrost.io and put its project id in all three
# URLs. The token reaches the browser with the rest of the network configuration.
MIDNIGHT_INDEXER_URL=https://midnight-preprod.blockfrost.io/api/v0?project_id=<token>
MIDNIGHT_INDEXER_WS_URL=wss://midnight-preprod.blockfrost.io/api/v0/ws?project_id=<token>
MIDNIGHT_NODE_URL=https://rpc.midnight-preprod.blockfrost.io?project_id=<token>
# The proof server always runs locally, since it sees private witness data. The default is
# http://127.0.0.1:6300, the port the midnight-examples compose proof-server service publishes.
#MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# Sepolia over its default public RPC. EVM_RPC_URL overrides it.
EVM_CHAIN_ID=11155111
#EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Server-only values never reach the browser. Both match the services `yarn stack:up` starts.
DB_CONNECTION_STRING=postgres://demo:demo@localhost:5432/demo
KAFKA_BROKERS=localhost:9092

# The backend's own Midnight wallet, which proves and pays for the permissionless vault
# transactions. It must hold NIGHT registered for DUST on preprod: fund it through the preprod
# faucet at https://midnight-tmnight-preprod.nethermind.dev and register the NIGHT for DUST before
# the first operation.
MIDNIGHT_RELAYER_SEED=<32-byte seed in hex>

# Tests only. The integration tests play the user with this funded wallet.
#MIDNIGHT_USER_SEED=<32-byte seed in hex>

# Server logging: debug, info (the default), warn or error.
LOG_LEVEL=info

# README.md's Configuration section lists every variable, including the contract overrides and the
# MPC output cache.
