# Stagenet: copy to .env.local and fill in the relayer seed. Next.js reads .env files from the
# project root.

# Stagenet publishes the signet singleton, the MPC root key and the vault through the SDK
# packages, and the network selects the node and indexer endpoints.
MIDNIGHT_NETWORK_ID=stagenet
# The proof server always runs locally, since it sees private witness data. The default is
# http://127.0.0.1:6300, the port the midnight-examples compose proof-server service publishes.
#MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# Sepolia over its default public RPC. EVM_RPC_URL overrides it.
EVM_CHAIN_ID=11155111
#EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Server-only values never reach the browser. Both match the services `yarn stack:up` starts.
DB_CONNECTION_STRING=postgres://demo:demo@localhost:5432/demo
KAFKA_BROKERS=localhost:9092

# The backend's own Midnight wallet, which proves and pays for the permissionless vault
# transactions. It must hold NIGHT registered for DUST on stagenet: fund it through the stagenet
# faucet and register the NIGHT for DUST before the first operation.
MIDNIGHT_RELAYER_SEED=<32-byte seed in hex>

# Tests only. The integration tests play the user with this funded wallet.
#MIDNIGHT_USER_SEED=<32-byte seed in hex>

# Server logging: debug, info (the default), warn or error.
LOG_LEVEL=info

# README.md's Configuration section lists every variable, including the endpoint and contract
# overrides and the MPC output cache.
