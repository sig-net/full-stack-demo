# Local demo defaults. The examples setup command generates .env.local with
# deployment values, fork identity and server funding credentials.
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=undeployed
NEXT_PUBLIC_SEPOLIA_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_MIDNIGHT_NODE_URL=http://127.0.0.1:9944
NEXT_PUBLIC_MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v3/graphql
NEXT_PUBLIC_MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v3/graphql/ws
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# Setup generates these public deployment values.
# NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS=
# NEXT_PUBLIC_MIDNIGHT_SIGNET_CONTRACT_ADDRESS=
# NEXT_PUBLIC_MPC_SECP256K1_PUBKEY=
# NEXT_PUBLIC_LOCAL_EVM_MARKER_ADDRESS=
# NEXT_PUBLIC_LOCAL_EVM_MARKER_CODE=

# Next.js serves both contract asset trees from /zk when this is unset.
# NEXT_PUBLIC_ZK_CONFIG_ORIGIN=

# Setup generates these server-only values. User wallet seeds and vault caller
# secrets stay in browser memory and are never part of public configuration.
# LOCAL_ANVIL_INSTANCE_ID=
# LOCAL_MIDNIGHT_GENESIS_SEED=
# RELAYER_PRIVATE_KEY=

# For hosted operation, select the deployed Midnight network and supply its
# node/indexer endpoints, EVM RPC and compatible deployment/MPC values.
# Local wallet funding requires development mode, undeployed Midnight,
# loopback endpoints and the matching live Anvil instance and fork marker.
