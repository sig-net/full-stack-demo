# Copy to .env.local and fill in the secrets at the bottom. Everything above is public
# config for the live stagenet + Sepolia demo and works as-is.

# --- Midnight (stagenet) ---
NEXT_PUBLIC_MIDNIGHT_NETWORK_ID=stagenet
NEXT_PUBLIC_MIDNIGHT_NODE_URL=wss://rpc.stagenet.shielded.tools
NEXT_PUBLIC_MIDNIGHT_INDEXER_URL=https://indexer.stagenet.shielded.tools/api/v4/graphql
NEXT_PUBLIC_MIDNIGHT_INDEXER_WS_URL=wss://indexer.stagenet.shielded.tools/api/v4/graphql/ws

# Each user runs their OWN local proof server (the vault circuits are too large for a shared one):
#   docker run -p 6300:6300 midnightntwrk/proof-server:9.0.0-rc.5_experimental midnight-proof-server -v
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# The prover keys (100-280 MB each) are hosted on object storage. The browser fetches them here.
NEXT_PUBLIC_ZK_CONFIG_ORIGIN=https://pub-40793a8fb6614e07b7850ef647fceaaf.r2.dev

# --- Contracts + MPC ---
# The vault and signet contract addresses of a deployed network come from the npm packages
# (@sig-net/midnight-examples-erc20-vault-contract and @sig-net/midnight), keyed by
# NEXT_PUBLIC_MIDNIGHT_NETWORK_ID. Set these two only for a local undeployed stack.
# NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS=
# NEXT_PUBLIC_MIDNIGHT_SIGNET_CONTRACT_ADDRESS=
NEXT_PUBLIC_MPC_SECP256K1_PUBKEY=0x024eef776e4f257d68983e45b340c2e9546c5df95447900b6aadfec68fb46fdee2

# The MPC responder (fakenet) that signs the EVM txs and posts attestations.
NEXT_PUBLIC_FAKENET_RESPONSES_URL=https://fakenet-production.up.railway.app

# --- Secrets / your own values (required to run) ---
# A Sepolia RPC (get a free key at infura.io or alchemy.com).
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# The relayer wallet that pays users' Sepolia gas. A JSON byte array whose first
# 32 bytes are the ETH private key. Fund that address with Sepolia ETH. Server-side only.
RELAYER_PRIVATE_KEY=[YOUR_RELAYER_KEY_BYTES]

# Your Midnight wallet seed (32-byte hex). Do NOT reuse a mainnet seed.
NEXT_PUBLIC_MIDNIGHT_SEED=REPLACE_WITH_A_RANDOM_64_CHAR_HEX_SEED
