# Copy to .env.local. Next.js reads .env files from the project root, not from src.

# Midnight network: undeployed (local stack) or stagenet. The network selects default endpoints,
# each URL variable overrides one of them.
MIDNIGHT_NETWORK_ID=stagenet
#MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
#MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws
#MIDNIGHT_NODE_URL=http://127.0.0.1:9944
#MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# Signet singleton and ERC20 vault on that network. Stagenet publishes all three through the
# SDK packages; the local stack deploys its own, so all three are required for undeployed.
#MIDNIGHT_SIGNET_CONTRACT_ADDRESS=<32-byte hex>
#MIDNIGHT_SIGNET_MPC_ROOT_PUBLIC_KEY=<secp256k1 public key, SEC1 hex or secp256k1:base58>
#MIDNIGHT_ETHEREUM_ERC20_VAULT_CONTRACT_ADDRESS=<32-byte hex>

# Ethereum: the chain selects the default RPC (1, 11155111 or 31337), EVM_RPC_URL overrides it
# and is required for any other chain.
EVM_CHAIN_ID=11155111
#EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Server-only values never reach the browser. Both match the services that
# `docker compose up -d --wait` starts.
DB_CONNECTION_STRING=postgres://demo:demo@localhost:5432/demo
# Kafka bootstrap brokers, comma-separated host:port.
KAFKA_BROKERS=localhost:9092
# The root the backend's proof provider searches for every contract's prover keys and ZKIR, one
# subdirectory per contract, built by `yarn zk-assets` into zk-assets/ by default.
#MIDNIGHT_ZK_ASSETS_ROOT=zk-assets
# The backend's own Midnight wallet, which proves and pays for the permissionless vault
# transactions (flushes, sends, attestation queues). A 32-byte HD seed in hex; the wallet must
# hold NIGHT registered for DUST on the configured network.
MIDNIGHT_RELAYER_SEED=<32-byte seed in hex>
# Where the backend obtains the bytes an MPC attestation is verified over: evm-node recomputes
# them from the mined transaction's trace on EVM_RPC_URL (which must serve debug_traceTransaction),
# mpc-cache downloads them from the MPC's output cache at MPC_OUTPUT_CACHE_URL.
#RESPOND_OUTPUT_SOURCE=evm-node
#MPC_OUTPUT_CACHE_URL=

# Tests only. The integration tests play the user with this funded Midnight wallet seed.
#MIDNIGHT_USER_SEED=<32-byte seed in hex>
